# Copy to web/.env.local. Leave everything blank to run the demo on dummy data.

# --- Production database + manager sign-in (Supabase, EU region). Unset = demo mode (local JSON file).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000
# 32+ random characters. Signs sessions and keys staff PINs; changing it invalidates all PINs.
SESSION_SECRET=

# --- Solver service (solver/). Defaults to the local one started by `npm run demo`.
SOLVER_URL=http://127.0.0.1:8000
# Optional shared secret; set the same value in the solver's environment.
SOLVER_API_KEY=

# --- AI rule translation. Unset = offline demo translator.
ANTHROPIC_API_KEY=
# CLAUDE_RULE_MODEL=claude-haiku-5-5
# CLAUDE_PRICE_IN_PER_MTOK=0.1
# CLAUDE_PRICE_OUT_PER_MTOK=0.5
# RULE_TRANSLATION_CAP=50

# --- Email (swap notifications). Unset = written to the outbox only.
RESEND_API_KEY=
EMAIL_FROM="Rota Agent <rota@yourdomain.co.uk>"

# --- Billing. Unset = buttons simulate billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Scheduled jobs (web/vercel.json): /api/cron/daily and /api/cron/frequent, called with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Web push (staff app). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.co.uk

# --- SMS (opt-in per person). Unset = no SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Server error reports: POST JSON {text, route, ...} to this URL (Slack webhook etc.)
MONITORING_WEBHOOK=

# --- Public base URL for the clock-in QR code (defaults to the request host)
APP_URL=

# --- Shown in the draft legal pages
LEGAL_ENTITY=
PRIVACY_CONTACT=
