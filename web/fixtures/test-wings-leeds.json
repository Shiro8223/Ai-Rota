  "rules": [
    {
      "originalText": "Never put two new starters on closing",
      "status": "confirmed",
      "constraint": {
        "type": "max_count",
        "shift": "close",
        "day": "*",
        "filter": {
          "field": "tenureDays",
          "op": "lt",
          "value": 90
        },
        "max": 1,
        "hard": true
      }
    },
    {
      "originalText": "Always have at least one shift lead on every shift",
      "status": "confirmed",
      "constraint": {
        "type": "min_count",
        "shift": "*",
        "day": "*",
        "filter": {
          "field": "role",
          "op": "eq",
          "value": "Shift Lead"
        },
        "min": 1,
        "hard": true
      }
    },
    {
      "originalText": "Don't put Jordan and Casey on together",
      "status": "confirmed",
      "constraint": {
        "type": "never_together",
        "employees": [
          "jordan",
          "casey"
        ],
        "hard": true
      }
    },
    {
      "originalText": "Priya can't do Sunday mornings",
      "status": "confirmed",
      "constraint": {
        "type": "unavailable",
        "employee": "priya",
        "shift": "open",
        "day": "sun",
        "hard": true
      }
    },
    {
      "originalText": "Mia would rather work weekends",
      "status": "confirmed",
      "constraint": {
        "type": "prefer",
        "employee": "mia",
        "filter": null,
        "shift": "*",
        "day": "weekend",
        "avoid": false,
        "weight": 3,
        "hard": false
      }
    },
    {
      "originalText": "At least one back of house on every shift",
      "status": "pending",
      "constraint": {
        "type": "min_count",
        "shift": "*",
        "day": "*",
        "filter": {
          "field": "role",
          "op": "eq",
          "value": "Back of House"
        },
        "min": 1,
        "hard": true
      }
    }
  ],
